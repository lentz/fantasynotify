{
  "name": "fantasynotify",
  "version": "1.0.0",
  "description": "Transaction notifications for Yahoo Fantasy Leagues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lentz/fantasynotify.git"
  },
  "author": "Jesse Lentz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lentz/fantasynotify/issues"
  },
  "homepage": "https://github.com/lentz/fantasynotify#readme",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check-leagues": "node ./checkLeagues.ts",
    "lint": "biome check --error-on-warnings",
    "prepare": "husky",
    "start": "node --watch --inspect=:9229 app.ts",
    "test": "node --experimental-test-module-mocks --import ./test/setup.ts --test test/*.test.ts",
    "test:watch": "node --experimental-test-module-mocks --import ./test/setup.ts --test --watch test/*.test.ts"
  },
  "dependencies": {
    "client-oauth2": "^4.3.3",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.4",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "resend": "^6.41.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
